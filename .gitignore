# Publish only plugin runtime sources, build inputs and installation metadata.
# Everything else stays local, including experiments, tests and generated data.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/src/
!/adapters/
!/vendor/
!/build/
/build/*
!/build/build.mjs
!/build/verify-core.mjs
!/build/verify-panel.mjs
!/locale/
!/icon.svg
/vendor/core/README.md

# Local/test files are excluded even inside public source directories.
**/__tests__/
**/__pycache__/
**/node_modules/
**/fixtures/
**/*.test.*
**/*.spec.*
**/.DS_Store
**/.env
**/.env.*
**/*.log
**/*.sqlite*
**/*.db

# Private validation, experiments, reports and runtime outputs stay local.
/tests/
/experiments/
/docs/
!/docs/
/docs/*
!/docs/DETAIL.md
# Public README diagrams and mock-data UI screenshots only; other docs stay local.
!/docs/images/
/docs/images/*
!/docs/images/*.png
!/docs/evidence/
/docs/evidence/*
!/docs/evidence/ui/
/docs/evidence/ui/*
!/docs/evidence/ui/memory.png
!/docs/evidence/ui/skills.png
/.artifacts/
/AGENTS.md
/lib/
/node_modules/

# Publish only plugin runtime sources, build inputs and installation metadata.
# Everything else stays local, including experiments, tests and generated data.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/cordis.patch.yml
!/src/
!/adapters/
!/vendor/
!/build/
/build/*
!/build/build.mjs
!/build/verify-core.mjs
!/build/verify-panel.mjs
/vendor/core/README.md

# Local/test files are excluded even inside public source directories.
**/__tests__/
**/__pycache__/
**/node_modules/
**/fixtures/
**/*.test.*
**/*.spec.*
**/.DS_Store
**/.env
**/.env.*
**/*.log
**/*.sqlite*
**/*.db

# Private validation, experiments, reports and runtime outputs stay local.
/tests/
/experiments/
/docs/
/.artifacts/
/AGENTS.md
/lib/
/node_modules/
